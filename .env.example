# Copy to ~/.config/agentbus/env and fill in a real token (openssl rand -hex 24).
# The same file is sourced by the API, the worker and the `ab` client.

AGENTBUS_TOKEN=change-me

# API process
AGENTBUS_DATABASE_URL=postgresql://agentbus:agentbus@127.0.0.1:5455/agentbus
AGENTBUS_BIND_HOST=127.0.0.1
AGENTBUS_BIND_PORT=8787
AGENTBUS_LEASE_TTL=900
AGENTBUS_MAX_WAIT=120
AGENTBUS_ARTIFACTS_DIR=~/.local/state/agentbus/artifacts

# Worker process
AGENTBUS_URL=http://127.0.0.1:8787
AGENTBUS_AGENT=local-opencode
AGENTBUS_MODEL=opencode-go/deepseek-v4.1-flash
AGENTBUS_REPOS=/home/ruslan/personal,/home/ruslan/gg
AGENTBUS_STATE_DIR=~/.local/state/agentbus
AGENTBUS_TASK_TIMEOUT=2400
AGENTBUS_OPENCODE_BIN=opencode

# File bridge for the isolated VM: no network, only a directory that Cage already
# shares. Cage mounts a project folder at its own host path, so this value is the
# same on the host and inside the VM. `cb` finds it without this variable at all;
# set it only if the share lives elsewhere.
AGENTBUS_SHARE=/home/ruslan/personal/.agentbus/cage-claude
AGENTBUS_BRIDGE_AGENT=cage-claude
AGENTBUS_BRIDGE_INTERVAL=2

# Client identity, one per agent
# AGENTBUS_SELF=cage-claude
# AGENTBUS_SELF=local-opencode
