# Copy to ~/.config/agentbus/env and fill in a real token (openssl rand -hex 24).
# The same file is sourced by the API, the worker and the `ab` client.

AGENTBUS_TOKEN=change-me

# API process
AGENTBUS_DATABASE_URL=postgresql://agentbus:agentbus@127.0.0.1:5455/agentbus
AGENTBUS_BIND_HOST=127.0.0.1
AGENTBUS_BIND_PORT=8787
AGENTBUS_LEASE_TTL=900
# Cap of concurrent leases per sender for one recipient (0 = no cap). Keeps one
# session with a long queue from taking every executor slot.
AGENTBUS_PER_SENDER_LEASES=0
AGENTBUS_MAX_WAIT=120
AGENTBUS_ARTIFACTS_DIR=~/.local/state/agentbus/artifacts
# Hosts allowed in the `Host` header (DNS rebinding guard), comma separated.
# Defaults to 127.0.0.1:<port>,localhost:<port>.
# AGENTBUS_ALLOWED_HOSTS=127.0.0.1:8787,localhost:8787

# Worker process
AGENTBUS_URL=http://127.0.0.1:8787
AGENTBUS_AGENT=local-opencode
AGENTBUS_MODEL=opencode-go/deepseek-v4.1-flash
AGENTBUS_REPOS=/home/ruslan/personal,/home/ruslan/gg
AGENTBUS_STATE_DIR=~/.local/state/agentbus
AGENTBUS_TASK_TIMEOUT=2400
AGENTBUS_OPENCODE_BIN=opencode
# Author of the worker commit on the thread branch: Name <email>
AGENTBUS_COMMIT_AUTHOR="agentbus executor <agentbus@localhost>"
# Parallel executor slots on this host (suite recommendation: 3-4). Each slot is a
# separate lease owner `<agent>#<slot>` and its own git worktree per thread.
AGENTBUS_WORKER_SLOTS=1
# How long a SIGTERM waits for running tasks before their process groups are killed.
# Defaults to AGENTBUS_TASK_TIMEOUT.
AGENTBUS_STOP_GRACE=2400

# File bridge for the isolated VM: no network, only a directory that Cage already
# shares. One bridge process serves every mailbox folder inside the root; the folder
# name is the agent name. Cage mounts a project folder at its own host path, so these
# values are the same on the host and inside the VM. `cb` finds its mailbox without
# these variables at all; set them only if the share lives elsewhere.
#
# Root of all mailboxes. Optional: when unset, the bridge uses the parent of
# AGENTBUS_SHARE. Set it to serve every mailbox under one root.
AGENTBUS_SHARE_ROOT=/home/ruslan/personal/.agentbus
AGENTBUS_SHARE=/home/ruslan/personal/.agentbus/cage-claude
# Obsolete: the agent name is the mailbox folder name and this value is ignored.
# AGENTBUS_BRIDGE_AGENT=cage-claude
AGENTBUS_BRIDGE_INTERVAL=2

# Client identity, one per agent. `cb` picks its mailbox in this order:
# AGENTBUS_SHARE -> AGENTBUS_MAILBOX -> git root cwd -> cage-claude. Set
# AGENTBUS_MAILBOX explicitly (env or every command) so replies do not move to
# another mailbox when cwd changes; `cb env` prints the chosen one.
# AGENTBUS_MAILBOX=cage-claude
# AGENTBUS_SELF=cage-claude
# AGENTBUS_SELF=local-opencode

# `make prune` / `python -m agentbus.prune` reuse AGENTBUS_DATABASE_URL,
# AGENTBUS_STATE_DIR, AGENTBUS_ARTIFACTS_DIR and AGENTBUS_REPOS from this file:
# it deletes worktrees, artifacts and threads/<id>.json of closed threads beyond
# the last KEEP (50 by default). `make prune PRUNE_ARGS=--dry-run` prints the plan.
