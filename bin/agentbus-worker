#!/usr/bin/env bash
# Starts the executor worker with settings from ~/.config/agentbus/env.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ENV_FILE="${AGENTBUS_ENV:-$HOME/.config/agentbus/env}"
[ -f "$ENV_FILE" ] && set -a && . "$ENV_FILE" && set +a
cd "$ROOT"
exec uv run python -m agentbus.worker
