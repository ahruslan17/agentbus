#!/usr/bin/env python3
"""cb — agentbus client for a VM that has no network access, only a shared directory.

Everything it does is files inside the agent's own mailbox folder in the share:

    cb init                          # create the mailbox (or `cb init my-name`)
    cb send --to local-opencode --repo /path/to/repo "do X"        # -> outbox/
    cb inbox                                                      # new messages
    cb show m_...                                                 # message.json
    cb body m_... | cb patch m_...                                 # text / diff
    cb reply m_... --kind verdict "fix Y"                          # -> outbox/
    cb wait m_... [--all] [--timeout 600]                          # answers by parent_id
    cb status [--json] [--log] [id ...]                            # queue state from status.json
    cb accept m_... [--note "..."]                                 # accept a result
    cb read m_...                                                  # move to read/

The mailbox is picked in this order:

1. ``AGENTBUS_SHARE`` — full path to the mailbox folder;
2. ``AGENTBUS_MAILBOX=<name>`` — ``<root>/<name>``;
3. inside a git repository — ``claude-<normalized repo folder name>``;
4. otherwise ``cage-claude`` (backward compatibility).

``<root>`` is ``AGENTBUS_SHARE_ROOT`` or the ``.agentbus`` folder next to this
checkout. Only the standard library is used, so it runs anywhere python3 exists.
"""

from __future__ import annotations

import argparse
import datetime
import json
import os
import re
import shutil
import sys
import time
import uuid
from pathlib import Path

MAILBOX_NAME = re.compile(r"^[a-z0-9][a-z0-9-]{1,40}$")
DEFAULT_MAILBOX = "cage-claude"
DEFAULT_STATUS_INTERVAL = 5.0
STATUS_MIN_STALE_SECONDS = 30.0


def share_root() -> Path:
    """The folder that holds every mailbox: AGENTBUS_SHARE_ROOT or next to this checkout."""
    raw = os.environ.get("AGENTBUS_SHARE_ROOT", "").strip()
    if raw:
        return Path(os.path.expanduser(raw))
    here = Path(os.path.realpath(__file__))
    return here.parents[2] / ".agentbus"


def normalize_mailbox(raw: str) -> str:
    """``My_Repo.v2`` -> ``my-repo-v2``: lower-case, [a-z0-9-] only, no repeats, 33 chars."""
    name = re.sub(r"[^a-z0-9-]", "-", raw.lower())
    name = re.sub(r"-{2,}", "-", name).strip("-")
    return name[:33].strip("-")


def git_toplevel() -> Path | None:
    """Found by walking up to ``.git``; git itself is not available in the VM."""
    try:
        current = Path.cwd().resolve()
    except OSError:
        return None
    for path in (current, *current.parents):
        if (path / ".git").exists():
            return path
    return None


def require_name(name: str) -> str:
    if not MAILBOX_NAME.fullmatch(name):
        sys.exit(f"cb: invalid mailbox name: {name!r}\n"
                 f"cb: expected ^[a-z0-9][a-z0-9-]{{1,40}}$")
    return name


def resolve_share() -> tuple[Path, str, str]:
    """Return (mailbox path, mailbox name, which rule matched)."""
    raw = os.environ.get("AGENTBUS_SHARE", "").strip()
    if raw:
        path = Path(os.path.expanduser(raw))
        return path, path.name, "AGENTBUS_SHARE"

    root = share_root()
    name = os.environ.get("AGENTBUS_MAILBOX", "").strip()
    if name:
        require_name(name)
        return root / name, name, "AGENTBUS_MAILBOX"

    top = git_toplevel()
    if top is not None:
        name = f"claude-{normalize_mailbox(top.name) or 'repo'}"
        require_name(name)
        return root / name, name, "git"

    return root / DEFAULT_MAILBOX, DEFAULT_MAILBOX, "default"


def share() -> Path:
    """An existing mailbox; every command except send/reply/init needs one."""
    root, _, _ = resolve_share()
    if not root.is_dir():
        sys.exit(f"cb: share directory does not exist: {root}\n"
                 f"cb: set AGENTBUS_SHARE, AGENTBUS_MAILBOX or run cb init")
    return root


def share_for_write() -> Path:
    """A mailbox for send/reply/init: created on demand."""
    root, _, _ = resolve_share()
    root.mkdir(parents=True, exist_ok=True)
    return root


def read_message(root: Path, message_id: str) -> dict:
    for folder in ("inbox", "read"):
        path = root / folder / message_id / "message.json"
        if path.is_file():
            return json.loads(path.read_text(encoding="utf-8"))
    sys.exit(f"cb: unknown message: {message_id}")


def find_message(root: Path, message_id: str) -> dict | None:
    for folder in ("inbox", "read"):
        path = root / folder / message_id / "message.json"
        if path.is_file():
            try:
                return json.loads(path.read_text(encoding="utf-8"))
            except (json.JSONDecodeError, UnicodeDecodeError):
                return None
    return None


def load_json(path: Path) -> dict | None:
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError, UnicodeDecodeError):
        return None
    return payload if isinstance(payload, dict) else None


def find_receipt(root: Path, message_id: str) -> dict | None:
    """The receipt of a message we sent: sent/<stem>.receipt.json with this id."""
    sent = root / "sent"
    if not sent.is_dir():
        return None
    for path in sorted(sent.glob("*.receipt.json")):
        receipt = load_json(path)
        if receipt and str(receipt.get("id")) == message_id:
            return receipt
    return None


def ticket_of(root: Path, message: dict, seen: set[str] | None = None) -> str | None:
    """meta.ticket of the nearest ancestor we can reach through receipts."""
    seen = seen if seen is not None else set()
    message_id = str(message.get("id"))
    if message_id in seen:
        return None
    seen.add(message_id)

    ticket = (message.get("meta") or {}).get("ticket")
    if ticket:
        return str(ticket)

    parent_id = message.get("parent_id")
    if not parent_id:
        return None
    parent_id = str(parent_id)

    receipt = find_receipt(root, parent_id)
    if receipt:
        file = receipt.get("file")
        if file:
            sent_file = load_json(root / "sent" / str(file))
            if sent_file:
                ticket = (sent_file.get("meta") or {}).get("ticket")
                if ticket:
                    return str(ticket)
    parent = find_message(root, parent_id)
    if parent:
        return ticket_of(root, parent, seen)
    return None


def drop(root: Path, payload: dict) -> Path:
    outbox = root / "outbox"
    outbox.mkdir(parents=True, exist_ok=True)
    name = f"{time.strftime('%Y%m%d-%H%M%S')}-{uuid.uuid4().hex[:8]}.json"
    staging = outbox / f".{name}.tmp"
    staging.write_text(
        json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
    )
    target = outbox / name
    os.replace(staging, target)
    return target


def wait_receipt(root: Path, stem: str, seconds: float) -> tuple[dict | None, str | None]:
    """Poll sent/<stem>.receipt.json. Returns (receipt, error text)."""
    if seconds <= 0:
        return None, None
    deadline = time.monotonic() + seconds
    while True:
        receipt = load_json(root / "sent" / f"{stem}.receipt.json")
        if receipt is not None:
            return receipt, None
        failed = root / "failed" / f"{stem}.json"
        if failed.exists():
            error = failed.with_suffix(".error")
            text = error.read_text(encoding="utf-8").strip() if error.is_file() else ""
            return None, text or f"{failed.name} rejected by the bridge"
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return None, None
        time.sleep(min(0.5, remaining))


def read_body(args: argparse.Namespace) -> str:
    if getattr(args, "body_flag", None):
        return args.body_flag
    if args.text:
        return " ".join(args.text)
    if args.body_file:
        return Path(args.body_file).read_text(encoding="utf-8")
    if not sys.stdin.isatty():
        data = sys.stdin.read()
        if data.strip():
            return data
    sys.exit("cb: empty body")


def print_with_receipt(root: Path, path: Path, shown: dict, wait_seconds: float) -> int:
    receipt, error = wait_receipt(root, path.stem, wait_seconds)
    if error is not None:
        print(f"cb: {error}", file=sys.stderr)
        return 1
    if receipt is not None:
        shown["id"] = receipt.get("id")
        shown["thread_id"] = receipt.get("thread_id")
    elif wait_seconds > 0:
        print(f"cb: no receipt after {wait_seconds:g}s, message id is unknown", file=sys.stderr)
    print(json.dumps(shown, ensure_ascii=False, indent=2))
    return 0


def cmd_send(args: argparse.Namespace) -> int:
    root = share_for_write()
    payload: dict = {
        "recipient": args.to,
        "kind": args.kind,
        "body": read_body(args),
        "meta": json.loads(args.meta),
    }
    for flag, key in (("thread", "thread_id"), ("repo", "repo"), ("base", "base_ref"),
                      ("parent", "parent_id")):
        value = getattr(args, flag)
        if value:
            payload[key] = value
    path = drop(root, payload)
    shown = {"queued_file": str(path)}
    shown.update({k: v for k, v in payload.items() if k != "body"})
    code = print_with_receipt(root, path, shown, args.wait_id)
    if code == 0:
        print("the host will pick the file up within a couple of seconds", file=sys.stderr)
    return code


def cmd_reply(args: argparse.Namespace) -> int:
    root = share_for_write()
    original = read_message(root, args.message_id)
    meta = json.loads(args.meta)
    if args.kind == "verdict":
        meta.setdefault("decision", "rework")
        if not meta.get("ticket"):
            ticket = ticket_of(root, original)
            if ticket:
                meta["ticket"] = ticket
    payload = {
        "recipient": original["sender"],
        "kind": args.kind,
        "body": read_body(args),
        "thread_id": original.get("thread_id"),
        "parent_id": args.message_id,
        "meta": meta,
    }
    path = drop(root, payload)
    shown = {"queued_file": str(path), "reply_to": args.message_id,
             "recipient": payload["recipient"], "kind": payload["kind"],
             "meta": meta}
    return print_with_receipt(root, path, shown, args.wait_id)


def inbox_messages(root: Path) -> list[dict]:
    """Every delivered message, unread first, deduplicated by id."""
    messages: dict[str, dict] = {}
    for folder_name in ("inbox", "read"):
        folder = root / folder_name
        if not folder.is_dir():
            continue
        for path in sorted(folder.iterdir()):
            if not path.is_dir() or path.name.startswith("."):
                continue
            message = load_json(path / "message.json")
            if message:
                messages.setdefault(str(message.get("id")), message)
    return list(messages.values())


def cmd_inbox(args: argparse.Namespace) -> int:
    root = share()
    inbox = root / "inbox"
    read = root / "read"
    entries = sorted((p for p in inbox.iterdir() if p.is_dir() and not p.name.startswith(".")),
                     key=lambda p: p.name)
    shown = 0
    for folder in entries:
        if (read / folder.name).exists():
            continue
        message = json.loads((folder / "message.json").read_text(encoding="utf-8"))
        if args.folder:
            print(folder.name)
        else:
            ticket = ticket_of(root, message)
            suffix = f"  ticket {ticket}" if ticket else ""
            first = (message.get("body") or "").strip().splitlines()
            print(f"{message['id']}  [{message['kind']}] from {message['sender']}  "
                  f"thread {message.get('thread_id')}{suffix}")
            if first:
                print(f"    {first[0][:160]}")
            if message.get("artifacts"):
                print(f"    files: {', '.join(message['artifacts'])}")
        shown += 1
    if not shown and not args.folder:
        print("no new messages")
    return 0


def cmd_show(args: argparse.Namespace) -> int:
    root = share()
    message = read_message(root, args.message_id)
    if args.text:
        ticket = ticket_of(root, message)
        suffix = f"  ticket {ticket}" if ticket else ""
        print(f"# {message['id']} [{message['kind']}] from {message['sender']} "
              f"thread {message.get('thread_id')}{suffix}\n")
        print(message.get("body") or "")
        stat = (message.get("meta") or {}).get("diff_stat")
        if stat:
            print("\n" + stat)
    else:
        print(json.dumps(message, ensure_ascii=False, indent=2))
    return 0


def cmd_body(args: argparse.Namespace) -> int:
    message = read_message(share(), args.message_id)
    print(message.get("body") or "")
    return 0


def cmd_file(args: argparse.Namespace) -> int:
    root = share()
    for folder in ("inbox", "read"):
        path = root / folder / args.message_id / args.name
        if path.is_file():
            sys.stdout.write(path.read_text(encoding="utf-8", errors="replace"))
            return 0
    sys.exit(f"cb: no {args.name} for {args.message_id}")


def move_to_read(root: Path, message_id: str) -> None:
    source = root / "inbox" / message_id
    if not source.is_dir():
        sys.exit(f"cb: inbox/{message_id} not found")
    target = root / "read" / message_id
    target.parent.mkdir(parents=True, exist_ok=True)
    if target.exists():
        shutil.rmtree(target)
    shutil.move(str(source), str(target))


def cmd_read(args: argparse.Namespace) -> int:
    root = share()
    move_to_read(root, args.message_id)
    print(f"moved to read/{args.message_id}")
    return 0


def cmd_accept(args: argparse.Namespace) -> int:
    root = share()
    folder = root / "inbox" / args.message_id
    if not folder.is_dir():
        sys.exit(f"cb: inbox/{args.message_id} not found")
    decision = {"decision": "accept", "note": args.note or ""}
    (folder / "decision.json").write_text(
        json.dumps(decision, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
    )
    move_to_read(root, args.message_id)
    print(f"accepted {args.message_id} -> read/{args.message_id}")
    return 0


def checks_label(message: dict) -> str:
    checks = (message.get("meta") or {}).get("checks")
    if isinstance(checks, dict) and "ok" in checks:
        return "ok" if checks.get("ok") else "fail"
    return "-"


def wait_line(root: Path, message: dict) -> str:
    ticket = ticket_of(root, message) or "-"
    timeout = str(bool((message.get("meta") or {}).get("timeout"))).lower()
    return (f"{message.get('parent_id')} -> {message.get('id')}  "
            f"[{message.get('kind')}]  {ticket}  "
            f"checks={checks_label(message)}  timeout={timeout}")


# --- status.json published by the bridge --------------------------------------


def parse_instant(raw: object) -> float | None:
    if not raw:
        return None
    text = str(raw).strip()
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    try:
        moment = datetime.datetime.fromisoformat(text)
    except ValueError:
        return None
    if moment.tzinfo is None:
        moment = moment.replace(tzinfo=datetime.timezone.utc)
    return moment.timestamp()


def status_age(payload: dict | None, now: float | None = None) -> float | None:
    if not payload:
        return None
    moment = parse_instant(payload.get("generated_at"))
    if moment is None:
        return None
    return max(0.0, (now if now is not None else time.time()) - moment)


def status_interval(payload: dict | None) -> float:
    bridge = (payload or {}).get("bridge")
    raw = bridge.get("interval") if isinstance(bridge, dict) else None
    try:
        return float(raw)
    except (TypeError, ValueError):
        return DEFAULT_STATUS_INTERVAL


def status_stale(payload: dict, age: float | None) -> bool:
    if age is None:
        return True
    return age > max(STATUS_MIN_STALE_SECONDS, 6 * status_interval(payload))


def human_duration(seconds: float) -> str:
    total = int(max(0.0, seconds))
    if total < 60:
        return f"{total}s"
    minutes = total // 60
    if minutes < 60:
        return f"{minutes}m"
    hours = minutes // 60
    if hours < 24:
        return f"{hours}h"
    return f"{hours // 24}d"


def ordinal(number: int) -> str:
    if 10 <= number % 100 <= 20:
        suffix = "th"
    else:
        suffix = {1: "st", 2: "nd", 3: "rd"}.get(number % 10, "th")
    return f"{number}{suffix}"


def format_age(raw: object, now: float) -> str | None:
    moment = parse_instant(raw)
    if moment is None:
        return None
    return human_duration(now - moment)


def status_pending(payload: dict) -> list[dict]:
    pending = payload.get("pending")
    return [item for item in pending if isinstance(item, dict)] if isinstance(pending, list) else []


def slot_line(
    slot: dict,
    pending_by_id: dict[str, dict],
    lease_started: dict[str, object],
    now: float,
) -> str:
    slot_id = str(slot.get("id") or "?")
    state = str(slot.get("state") or "unknown")
    if slot.get("stale"):
        return f"{slot_id} stale"
    if state != "busy":
        return f"{slot_id} {state}"
    message_id = slot.get("message_id")
    line = f"{slot_id} busy"
    if message_id:
        line += f" {message_id}"
    if slot.get("ticket"):
        line += f" [{slot['ticket']}]"
    if slot.get("sender"):
        line += f" ({slot['sender']})"
    item = pending_by_id.get(str(message_id)) if message_id else None
    if item is not None:
        age = format_age(lease_started.get(str(message_id)) or item.get("updated_at"), now)
        if age:
            line += f" {age}"
    return line


def message_line(item: dict, leased_at: object, now: float) -> str:
    message_id = str(item.get("id") or "?")
    ticket = item.get("ticket")
    prefix = f"{message_id} [{ticket}]" if ticket else message_id
    state = str(item.get("state") or "?")
    if state == "queued":
        position = item.get("queue_position")
        number = int(position) if isinstance(position, int) else 1
        return f"{prefix} queued, ~{ordinal(number)} in line"
    if state == "leased":
        owner = item.get("lease_owner") or "?"
        attempt = int(item.get("attempt") or 0)
        line = f"{prefix} leased by {owner}, attempt {attempt}"
        age = format_age(leased_at or item.get("updated_at"), now)
        return f"{line}, {age}" if age else line
    if item.get("result_id"):
        return f"{prefix} {state} → result {item['result_id']}"
    return f"{prefix} {state}"


def status_transitions(root: Path, ids: list[str], seen: dict[str, str]) -> None:
    """One stderr line per changed state of a waited message, when status.json exists."""
    payload = load_json(root / "status.json")
    if not payload:
        return
    states = {str(item.get("id")): item for item in status_pending(payload)}
    for message_id in ids:
        item = states.get(message_id)
        if item is None:
            continue
        state = str(item.get("state") or "")
        previous = seen.get(message_id)
        seen[message_id] = state
        if previous is None or previous == state:
            continue
        target = state
        if state == "leased" and item.get("lease_owner"):
            target = f"leased by {item['lease_owner']}"
        print(f"{message_id} {previous} → {target}", file=sys.stderr, flush=True)


def cmd_status(args: argparse.Namespace) -> int:
    root = share()
    path = root / "status.json"
    payload = load_json(path) if path.is_file() else None
    age = status_age(payload)
    if args.json:
        if payload is None:
            print("status is stale — bridge or API down?")
            return 2
        print(path.read_text(encoding="utf-8").rstrip())
        stale = status_stale(payload, age)
        return 2 if stale or payload.get("error") else 0
    if payload is None:
        print("status is stale — bridge or API down?")
        return 2
    if status_stale(payload, age):
        print(f"status is stale ({int(age or 0)}s) — bridge or API down?")
        return 2
    print(f"status: {int(age or 0)}s ago")
    if payload.get("error"):
        print(f"error: {payload['error']}")
        return 2

    now = time.time()
    pending = status_pending(payload)
    pending_by_id = {str(item.get("id")): item for item in pending}
    lease_started: dict[str, object] = {}
    for event in payload.get("events") or []:
        if not isinstance(event, dict) or event.get("kind") != "leased":
            continue
        message_id = event.get("message_id")
        if message_id:
            lease_started[str(message_id)] = event.get("at")

    for slot in payload.get("workers") or []:
        if isinstance(slot, dict):
            print(slot_line(slot, pending_by_id, lease_started, now))

    wanted = set(args.ids)
    for item in pending:
        message_id = str(item.get("id"))
        if wanted and message_id not in wanted:
            continue
        print(message_line(item, lease_started.get(message_id), now))
        if args.log and item.get("state") == "leased":
            for line in item.get("log_tail") or []:
                print(f"    {line}")
    return 0


def cmd_wait(args: argparse.Namespace) -> int:
    root = share()
    ids = list(dict.fromkeys(args.ids))
    deadline = time.monotonic() + args.timeout
    answered: dict[str, set[str]] = {message_id: set() for message_id in ids}
    printed: set[str] = set()
    seen_states: dict[str, str] = {}

    while True:
        for message in inbox_messages(root):
            message_id = str(message.get("id"))
            parent_id = str(message.get("parent_id") or "")
            if parent_id not in answered or message_id in printed:
                continue
            printed.add(message_id)
            answered[parent_id].add(message_id)
            print(wait_line(root, message))

        status_transitions(root, ids, seen_states)

        if printed and not args.all:
            return 0
        if args.all and all(answered.values()):
            return 0
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return 2
        time.sleep(min(2.0, remaining))


def cmd_sent(args: argparse.Namespace) -> int:
    root = share()
    sent = root / "sent"
    failed = root / "failed"
    names = sorted(p.name for p in sent.glob("*.json")) if sent.is_dir() else []
    for name in names:
        print(f"sent   {name}")
    if failed.is_dir():
        for path in sorted(failed.glob("*.json")):
            error = path.with_suffix(".error")
            detail = error.read_text(encoding="utf-8").strip() if error.is_file() else ""
            print(f"failed {path.name}  {detail[:120]}")
    if not names and not (failed.is_dir() and any(failed.iterdir())):
        print("empty")
    return 0


def cmd_env(args: argparse.Namespace) -> int:
    root = share()
    _, mailbox, source = resolve_share()
    age = status_age(load_json(root / "status.json"))
    print(json.dumps({
        "share": str(root),
        "mailbox": mailbox,
        "source": source,
        "outbox": str(root / "outbox"),
        "inbox": str(root / "inbox"),
        "unread": sum(1 for p in (root / "inbox").iterdir()
                      if p.is_dir() and not (root / "read" / p.name).exists())
        if (root / "inbox").is_dir() else 0,
        "status_age_seconds": None if age is None else int(age),
    }, ensure_ascii=False, indent=2))
    return 0


def cmd_init(args: argparse.Namespace) -> int:
    if args.name:
        root = share_root() / require_name(args.name)
    else:
        root, _, _ = resolve_share()
    for name in ("outbox", "inbox", "sent", "read"):
        (root / name).mkdir(parents=True, exist_ok=True)
    print(root)
    return 0


class _SubParser(argparse.ArgumentParser):
    """Subcommands must not abbreviate flags: --body is not --body-file."""

    def __init__(self, *args: object, **kwargs: object) -> None:
        kwargs["allow_abbrev"] = False
        super().__init__(*args, **kwargs)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="cb", description="agentbus client over a shared directory")
    sub = parser.add_subparsers(dest="command", required=True, parser_class=_SubParser)

    init = sub.add_parser("init", help="create the mailbox")
    init.add_argument("name", nargs="?")
    init.set_defaults(func=cmd_init)

    send = sub.add_parser("send", help="queue a message in outbox")
    send.add_argument("--to", required=True)
    send.add_argument("--kind", default="task")
    send.add_argument("--thread")
    send.add_argument("--repo")
    send.add_argument("--base")
    send.add_argument("--parent")
    send.add_argument("--meta", default="{}")
    send.add_argument("--wait-id", type=float, default=15.0,
                      help="seconds to wait for a receipt with the id (0 = don't wait)")
    send.add_argument("--body-file")
    send.add_argument("--body")
    send.add_argument("text", nargs="*")
    send.set_defaults(func=cmd_send)

    reply = sub.add_parser("reply", help="answer a message")
    reply.add_argument("message_id")
    reply.add_argument("--kind", default="verdict")
    reply.add_argument("--meta", default="{}")
    reply.add_argument("--wait-id", type=float, default=15.0,
                       help="seconds to wait for a receipt with the id (0 = don't wait)")
    reply.add_argument("--body-file")
    reply.add_argument("--body")
    reply.add_argument("text", nargs="*")
    reply.set_defaults(func=cmd_reply)

    inbox = sub.add_parser("inbox", help="new messages")
    inbox.add_argument("--folder", action="store_true", help="ids only")
    inbox.set_defaults(func=cmd_inbox)

    show = sub.add_parser("show", help="the whole message")
    show.add_argument("message_id")
    show.add_argument("--text", action="store_true")
    show.set_defaults(func=cmd_show)

    body = sub.add_parser("body", help="message text")
    body.add_argument("message_id")
    body.set_defaults(func=cmd_body)

    patch = sub.add_parser("patch", help="diff from the executor's reply")
    patch.add_argument("message_id")
    patch.set_defaults(
        func=lambda a: cmd_file(argparse.Namespace(message_id=a.message_id, name="patch.diff"))
    )

    read = sub.add_parser("read", help="move to read/")
    read.add_argument("message_id")
    read.set_defaults(func=cmd_read)

    accept = sub.add_parser("accept", help="accept the result and move it to read/")
    accept.add_argument("message_id")
    accept.add_argument("--note")
    accept.set_defaults(func=cmd_accept)

    wait = sub.add_parser("wait", help="wait for replies by parent_id")
    wait.add_argument("ids", nargs="+")
    wait.add_argument("--all", action="store_true", help="wait for replies to every id")
    wait.add_argument("--any", action="store_true", help="return after the first one (default)")
    wait.add_argument("--timeout", type=float, default=3600.0)
    wait.set_defaults(func=cmd_wait)

    sent = sub.add_parser("sent", help="what went to the queue")
    sent.set_defaults(func=cmd_sent)

    status = sub.add_parser("status", help="queue state from status.json")
    status.add_argument("ids", nargs="*")
    status.add_argument("--json", action="store_true", help="raw status.json")
    status.add_argument("--log", action="store_true",
                        help="log tail of leased messages")
    status.set_defaults(func=cmd_status)

    env = sub.add_parser("env", help="paths and state")
    env.set_defaults(func=cmd_env)

    return parser


def main() -> int:
    parser = build_parser()
    parser.allow_abbrev = False
    args = parser.parse_args()
    if getattr(args, "body", None):
        args.body_flag = args.body
    else:
        args.body_flag = None
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
