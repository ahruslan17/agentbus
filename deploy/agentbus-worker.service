[Unit]
Description=agentbus executor worker (OpenCode)
After=agentbus-api.service
Requires=agentbus-api.service

[Service]
Type=simple
ExecStart=%h/agentbus/bin/agentbus-worker
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
# Only the worker gets SIGTERM; running opencode children finish within TimeoutStopSec.
KillMode=mixed
# Must be >= AGENTBUS_STOP_GRACE, which defaults to AGENTBUS_TASK_TIMEOUT (2400s).
TimeoutStopSec=2460

[Install]
WantedBy=default.target
